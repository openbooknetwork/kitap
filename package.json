{
  "name": "@openbooknetwork/kitap",
  "version": "0.3.0",
  "description": "The book under the Open Book Network sites: stories of pages with a text beside a picture an engine draws, built to a static site in every language",
  "keywords": [
    "static-site",
    "book",
    "timeline",
    "i18n"
  ],
  "license": "MIT",
  "author": "Can Bascil",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openbooknetwork/kitap.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "kitap": "bin/kitap.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./schema": "./src/schema.mjs",
    "./worker": "./src/worker.mjs",
    "./package.json": "./package.json",
    "./cli": "./src/cli.mjs",
    "./src/*": "./src/*"
  },
  "files": [
    "bin",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "aws4fetch": "^1.0.20",
    "js-yaml": "^4.1.0",
    "lucide-static": "^1.49.0",
    "marked": "^15.0.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "homepage": "https://github.com/openbooknetwork/kitap#readme",
  "bugs": {
    "url": "https://github.com/openbooknetwork/kitap/issues"
  }
}
